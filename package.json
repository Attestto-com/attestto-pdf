{
  "name": "@attestto/pdf",
  "version": "0.1.0",
  "description": "PDF engine — read, render, sign (PAdES-B/T/LT), verify, Solana anchor",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Attestto-com/attestto-pdf.git"
  },
  "author": "Attestto <open@attestto.com>",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "node-forge": "^1.3.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/node-forge": "^1.3.14",
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
