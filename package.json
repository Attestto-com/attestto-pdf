{
  "name": "@attestto/pdf",
  "version": "0.2.0",
  "description": "PDF engine — read, render, sign (PAdES-B/T/LT), verify, Solana anchor",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./vue": {
      "import": "./src/components/index.ts",
      "types": "./src/components/index.ts"
    }
  },
  "files": [
    "dist",
    "src/components"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "gate-self-test": "node scripts/gate-self-test.mjs",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "gateSelfTest": {
    "workflow": ".github/workflows/ci.yml",
    "testScript": "test",
    "buildScript": "build",
    "gates": [
      {
        "name": "lint",
        "script": "lint",
        "seed": "src/__gate-self-test__.ts",
        "content": "export function seeded(): void {\n  const unused = 1\n}\n"
      },
      {
        "name": "test",
        "script": "test",
        "seed": "tests/__gate-self-test__.spec.ts",
        "content": "import { it, expect } from 'vitest'\nit('is a deliberate failure', () => { expect(1).toBe(2) })\n"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Attestto-com/attestto-pdf.git"
  },
  "author": "Attestto <open@attestto.com>",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "node-forge": "^1.3.1",
    "pdf-lib": "^1.17.1"
  },
  "peerDependencies": {
    "pdfjs-dist": ">=4.0.0",
    "vue": ">=3.4.0"
  },
  "peerDependenciesMeta": {
    "pdfjs-dist": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.2",
    "@types/node-forge": "^1.3.14",
    "eslint": "^10.8.1",
    "pdfjs-dist": "^4.10.38",
    "tsup": "^8.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10",
    "vue": "^3.5.41",
    "vue-tsc": "^2.2.12"
  },
  "overrides": {
    "brace-expansion": ">=1.1.18 <2",
    "esbuild": ">=0.28.1 <0.29",
    "js-yaml": ">=4.3.1 <5",
    "nanoid": ">=3.3.17 <4",
    "postcss": ">=8.5.23 <9",
    "vite": ">=7.3.5 <8"
  }
}
